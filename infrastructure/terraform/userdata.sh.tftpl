#!/bin/bash
set -euo pipefail
exec > >(tee /var/log/warehouse-bootstrap.log) 2>&1
dnf install -y docker git awscli
systemctl enable --now docker
usermod -aG docker ec2-user
mkdir -p /opt/warehouse
cd /opt/warehouse
git clone --branch '${branch}' '${repo_url}' app
cd app
aws ecr get-login-password --region '${region}' | docker login --username AWS --password-stdin "$(aws sts get-caller-identity --query Account --output text).dkr.ecr.${region}.amazonaws.com"
# No copiar secretos en user_data. Configurar API_KEY y DB_PASSWORD mediante servicio seguro antes de levantar aplicaciones.
cat > .env <<EOF
AWS_REGION=${region}
PROJECT_PREFIX=${prefix}
EOF
# El lanzamiento se delega a un provisionador posterior con secretos presentes.
# docker compose pull && docker compose up -d
