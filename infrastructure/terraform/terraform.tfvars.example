aws_region = "us-east-1"
bucket_name = "REEMPLAZAR-BUCKET-UNICO"
project_prefix = "warehouse-platform"
force_destroy_bucket = false
batch_subnet_ids = [
  "subnet-REEMPLAZAR"
]

batch_security_group_ids = [
  "sg-REEMPLAZAR"
]

batch_service_role_arn = "arn:aws:iam::REEMPLAZAR-CUENTA:role/aws-service-role/batch.amazonaws.com/AWSServiceRoleForBatch"

batch_job_role_arn       = "arn:aws:iam::REEMPLAZAR-CUENTA:role/LabRole"
batch_execution_role_arn = "arn:aws:iam::REEMPLAZAR-CUENTA:role/LabRole"

batch_image_uri = "REEMPLAZAR-CUENTA.dkr.ecr.us-east-1.amazonaws.com/warehouse-platform-batch:REEMPLAZAR-TAG"
