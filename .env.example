DATABASE_URL=postgresql+psycopg2://admin:admin@db:5432/platform
SQL_ECHO=false

# Identificador de esta bodega (texto). Cada instancia de la API usa el suyo.
WAREHOUSE_ID=WH-001

# Clave que los clientes envían en el header X-API-Key (todo menos /health).
API_KEY=dev-api-key

# RabbitMQ local (la URL interna de Compose usa el host `rabbitmq`).
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F
POSTGRES_HOST_PORT=5432

# Caché Redis (Cache Aside). CACHE_ENABLED=false la apaga (X-Cache: BYPASS).
REDIS_URL=redis://redis:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=30

# Pool de conexiones a PostgreSQL. Debe cubrir los 40 hilos de FastAPI (ver docs/fases/fase-2.md).
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20

# Almacenamiento S3 (S-05). En local es MinIO (docker compose --profile storage up -d);
# en AWS se deja S3_ENDPOINT_URL vacío y se usa el rol de la instancia.
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=warehouse-platform
AWS_DEFAULT_REGION=us-east-1
# Credenciales de MinIO local (las mismas de MINIO_ROOT_USER / MINIO_ROOT_PASSWORD).
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
